# Server-only secret created in Google AI Studio. Never prefix it with VITE_.
GEMINI_API_KEY=

# Standard Upstash names. The server also supports Vercel's prefixed
# UPSTASH_REDIS_REST_KV_REST_API_URL and ..._TOKEN variants.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini calls only. Local fallback answers do not consume these limits.
GEMINI_DAILY_LIMIT=10
GEMINI_VISITOR_DAILY_LIMIT=5

# Optional. If omitted, the Gemini API key is used only as the IP hashing salt.
RATE_LIMIT_SALT=
